# =====================================================================
# Salin file ini menjadi ".env" di folder backend/ lalu isi nilainya.
# File ini menggantikan .streamlit/secrets.toml versi Streamlit.
# =====================================================================

# --- API key Gemini (boleh isi 1 saja, atau beberapa untuk rotasi kuota) ---
# Nama variabel harus SAMA PERSIS dengan salah satu dari GEMINI_KEY_NAMES
# di app/services/rag_pipeline.py.
GEMINI_API_KEY=isi_api_key_gemini_anda_di_sini
# GEMINI_API_KEY_TEMP01=
# GEMINI_API_KEY_TEMP02=

# --- API key Groq (opsional, kalau dipakai di pipeline riset Anda) ---
# GROQ_API_KEY=

# --- Konfigurasi aplikasi FastAPI (prefix APP_) ---
APP_JWT_SECRET_KEY=ganti-dengan-string-acak-yang-panjang-dan-rahasia
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_DATA_DIR=./data
APP_ACCOUNTS_FILE=./accounts.json

# Kalau frontend dijalankan di server/port terpisah (bukan lewat mount
# StaticFiles bawaan), isi origin-nya di sini dipisah koma, misal:
# APP_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
APP_CORS_ORIGINS=*
